html
  head
    title Alfred
    style.
      .chat-window {
        border: 2px double black;
        border-radius: 5px;
        padding: 1rem;
        min-height: 75%;
        display: flex;
        flex-direction: column;
      }

      .prompt-container {
        width: calc(100% - 1rem);
        border: inherit;
        border-radius: inherit;
        padding: 0.25rem;
        margin-top: auto;
        bottom: 1rem;
        min-height: 3rem;
      }

      .prompt {
        width: 100%;
        outline: none;
      }

      .prompt:empty::after {
        content: "What's your question?";
        color: gray;
        display: inline-block;
        width: 100%;
        height: 100%;
      }


    script(type="module").
      import { AlfredChatbot } from '/alfred-chatbot.js';
      import { AlfredPrompt } from '/alfred-prompt.js';

      customElements.define('alfred-chatbot', AlfredChatbot);
      customElements.define('alfred-prompt', AlfredPrompt);
    
  body
    div(class='chat-window')
      div(class='scroll-container')
        alfred-chatbot Ask me a question!
      div(class="prompt-container")
        alfred-prompt
          span(class="prompt" contenteditable="true")