    "@types/hast": "^3.0.4",
    "@types/multiparty": "^4.2.1",
    "@types/node": "^24.9.2",
    "concurrently": "^9.2.1",
    "rollup": "^4.53.2",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-copy-watch": "^0.0.1",
    "rollup-plugin-minify-html-literals": "^1.2.6",
    "rollup-plugin-summary": "^3.0.1",
