{
  "name": "alfred",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "rollup -c && node --experimental-strip-types src/server.ts",
    "start-dev": "concurrently 'pnpm watch-client' 'pnpm watch-server'",
    "build-prod-image": "docker build -t alfred-image .",
    "build-dev-image": "docker build --build-arg DOCKER_LOCAL=true -t alfred-image .",
    "run-dev-image": "docker run -it -p 3000:3000 alfred-image",
    "watch-server": "node --experimental-strip-types --watch src/server.ts",
    "start:redis": "docker run -p 6379:6379 -d redis:8.0-rc1",
    "watch-client": "rollup -c -w",
    "start:ollama": "ollama run qwen3-vl --keepalive=-1m",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.19.0",
  "dependencies": {
    "@lit-labs/ssr": "^3.3.1",
    "@modelcontextprotocol/sdk": "^1.20.2",
    "@runware/sdk-js": "^1.2.3",
    "@types/mdast": "^4.0.4",
    "body-parser": "^2.2.0",
    "connect-redis": "^9.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "hast-util-is-element": "^3.0.0",
    "hast-util-to-text": "^4.0.2",
    "hastscript": "^9.0.1",
    "highlight.js": "^11.11.1",
    "lit": "^3.3.1",
    "lit-element": "^4.2.1",
    "lit-html": "^3.3.1",
    "multiparty": "^4.2.3",
    "ollama": "^0.6.0",
    "pug": "^3.0.3",
    "puppeteer": "^24.31.0",
    "redis": "^5.9.0",
    "rehype-highlight": "^7.0.2",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "stytch": "^12.43.0",
    "to-vfile": "^8.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "zod": "^4.1.12"
  },
